SECRET_KEY=replace-with-a-long-random-string
ADMIN_DEFAULT_PASSWORD=replace-with-a-strong-password
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_URL=http://localhost:11434
# Only needed for direct dev access to :3000/:8000 - the real distribution
# path is the Caddy gateway on :8080 (see deploy/caddy/Caddyfile), which is
# same-origin and needs no CORS entry. Don't add LAN IPs here, they go
# stale as the machine changes networks; use the Network Access tab in the
# admin dashboard to manage who can reach the Caddy gateway instead.
ALLOWED_ORIGINS=http://localhost:3000

# Caddy gateway (deploy/caddy/Caddyfile) - the backend regenerates this file
# and hot-reloads Caddy whenever the network allowlist changes in the admin
# dashboard. CADDY_ADMIN_URL is Caddy's local admin API, never exposed
# externally.
CADDY_CONFIG_PATH=../deploy/caddy/Caddyfile
CADDY_ADMIN_URL=http://localhost:2019

# Licensing (see deploy/license/README.md and deploy/license-server/README.md).
# Same URL for every customer's copy - fill this in once after deploying
# the Cloudflare Worker, then every future license.json you issue and ship
# activates against it automatically. Leave blank to license each install
# purely locally (no protection against reactivating a deleted-and-reused
# license on a different machine - see license_guard.py).
LICENSE_SERVER_URL=
